  "setup_instructions": {
    "newsapi": {
      "steps": [
        "1. Visit https://newsapi.org/register to create a free account",
        "2. Verify your email address",
        "3. Copy your API key from the dashboard",
        "4. Replace 'your-newsapi-key-here' with your actual API key",
        "5. Note the rate limits for your plan (free: 1,000/month, developer: 500/day)"
      ],
      "environment_variable": "NEWSAPI_KEY"
    },
    "rss_feeds": {
      "steps": [
        "1. RSS feeds generally don't require API keys",
        "2. Check the website's robots.txt and terms of service",
        "3. Implement reasonable rate limiting (recommended: 60 requests/hour)",
        "4. Monitor for changes in feed URLs",
        "5. Handle feed parsing errors gracefully"
      ]
    }
  },
  "rate_limiting_guidelines": {
    "newsapi_free": "33 requests per day (1,000/month)",
    "newsapi_developer": "500 requests per day",
    "newsapi_business": "Up to 250,000 requests per month",
    "rss_feeds": "60-120 requests per hour (respect server resources)",
    "general": "Always implement exponential backoff and respect Retry-After headers"
  },
  "troubleshooting": {
    "common_issues": [
      {
        "issue": "NewsAPI 401 Unauthorized",
        "solution": "Check that your API key is correct and active"
      },
